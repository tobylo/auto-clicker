# Starts auto-clicker with the graphical session. Enable it once per user:
#   systemctl --user enable --now auto-clicker
[Unit]
Description=Auto clicker in the system tray
Documentation=https://github.com/tobylo/auto-clicker#readme
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/auto-clicker
# Exit statuses: 0 after Quit, SIGTERM or SIGINT; 3 when another copy runs in
# this session, which restarting does not fix. Any other failure restarts
# after 5 s, backing off to 5 min. Without access to /dev/uinput or the
# keyboards, the daemon keeps running and the tray says why.
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=5min
RestartPreventExitStatus=3
# The daemon reaches the session and system buses through Unix sockets only.
# IPAddressDeny= would be ignored here: a user manager cannot set up the
# firewall it needs.
RestrictAddressFamilies=AF_UNIX
# The two ways around that filter: the 32-bit socketcall() ABI, and sockets
# made through io_uring.
SystemCallArchitectures=native
SystemCallFilter=~io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
