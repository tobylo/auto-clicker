// The settings window. Rust sets the fields from the daemon's view and
// reads them back for a save; every text the window shows is here, under
// @tr, so the bundled translations cover it all.

import { AboutSlint, Button, CheckBox, ComboBox, GroupBox, LineEdit, SpinBox, StandardListView, TabWidget, ScrollView, Palette } from "std-widgets.slint";

// Texts Rust builds messages from.
export global Texts {
    public pure function saved() -> string { @tr("Saved.") }
    public pure function saved-unsynced(why: string) -> string { @tr("Saved, but it may not survive a power loss: {}", why) }
    public pure function busy() -> string { @tr("Stop clicking, recording or playback first.") }
    public pure function failed(why: string) -> string { @tr("Not saved: {}", why) }
    public pure function refused(field: string, why: string) -> string { @tr("{}: {}", field, why) }
    public pure function unavailable(why: string) -> string { @tr("Not available: {}", why) }
    public pure function replace-changed() -> string { @tr("config.toml changed since the program read it. Replace it with these settings?") }
    public pure function replace-unusable() -> string { @tr("config.toml could not be used, so the program runs on the defaults. Replace it with these settings?") }
    public pure function without-modifier(actions: string) -> string { @tr("{} has no modifier, so it fires on a plain key press, in games too. Keep it?", actions) }
    public pure function capturing-hotkey() -> string { @tr("Press the new hotkey, or Esc to cancel.") }
    public pure function capturing-key() -> string { @tr("Press the key the clicker should press, or Esc to cancel.") }
    public pure function capture-cancelled() -> string { @tr("Cancelled.") }
    public pure function capture-timed-out() -> string { @tr("Nothing was pressed in time.") }
    public pure function capture-unnamed() -> string { @tr("That key has no name a hotkey can use; choose another.") }
    public pure function capture-interrupted() -> string { @tr("Stopped: something else happened.") }
    public pure function configured() -> string { @tr("System Settings opened at the program's shortcuts.") }
    public pure function field-delay() -> string { @tr("Delay before a tray start") }
    public pure function field-interval() -> string { @tr("Interval") }
    public pure function field-jitter() -> string { @tr("Jitter") }
    public pure function field-key() -> string { @tr("Key") }
    public pure function field-repeat() -> string { @tr("Repeat") }
    public pure function field-speed() -> string { @tr("Speed") }
    public pure function field-plays() -> string { @tr("Plays") }
    public pure function action-clicking() -> string { @tr("Start or stop clicking") }
    public pure function action-recording() -> string { @tr("Start or stop recording") }
    public pure function action-playback() -> string { @tr("Play or stop the recording") }
    public pure function not-set() -> string { @tr("not set") }
    public pure function not-reported() -> string { @tr("not reported yet") }
    public pure function unreadable(field: string) -> string { @tr("{}: cannot be read", field) }
    public pure function captured-hotkey(keys: string) -> string { @tr("Captured {}; save to keep it.", keys) }
    public pure function captured-key(key: string) -> string { @tr("Key set to {}; save to keep it.", key) }
    public pure function renamed() -> string { @tr("Renamed.") }
    public pure function deleted() -> string { @tr("Deleted.") }
    public pure function chosen() -> string { @tr("The playback hotkey plays this recording now.") }
    public pure function playing() -> string { @tr("Playing.") }
    public pure function delete-question(name: string) -> string { @tr("Delete {} for good? It cannot be undone.", name) }
    public pure function no-name() -> string { @tr("(the name cannot be read)") }
    public pure function more-recordings(count: string) -> string { @tr("{} older recordings are not listed.", count) }
    // What the daemon says, as core's messages give it: each with its own
    // values, and text from other programs passed through as it is.
    public pure function problem-clicking(why: string) -> string { @tr("Clicking cannot start: {}", why) }
    public pure function problem-unlisted(why: string) -> string { @tr("The recordings cannot be listed: {}", why) }
    public pure function config-no-directory() -> string { @tr("no config directory: neither XDG_CONFIG_HOME nor HOME is set") }
    public pure function config-unreadable(file: string, why: string) -> string { @tr("{}: could not read the file: {}", file, why) }
    public pure function config-invalid-at(file: string, line: string, why: string) -> string { @tr("{}:{}: {}", file, line, why) }
    public pure function config-invalid(file: string, why: string) -> string { @tr("config file" => "{}: {}", file, why) }
    public pure function blocked-locked() -> string { @tr("the screen is locked") }
    public pure function blocked-inactive() -> string { @tr("another session is in front") }
    public pure function blocked-sleeping() -> string { @tr("the computer is going to sleep") }
    public pure function blocked-unknown(why: string) -> string { @tr("the session state is unknown: {}", why) }
    public pure function input-no-permission(why: string) -> string { @tr("no permission to open /dev/uinput ({}); install the package's udev rule and log in again, or add your user to the `input` group", why) }
    public pure function input-uinput-missing(why: string) -> string { @tr("/dev/uinput is not available ({}); load the kernel module with `sudo modprobe uinput`", why) }
    public pure function input-create-device(why: string) -> string { @tr("could not create a virtual input device: {}", why) }
    public pure function input-write(why: string) -> string { @tr("could not write to a virtual input device: {}", why) }
    public pure function input-portal-unavailable(why: string) -> string { @tr("the desktop's remote input portal cannot be used: {}", why) }
    public pure function input-not-allowed() -> string { @tr("not allowed in the desktop's dialog; Start asks again") }
    public pure function input-allowed-now() -> string { @tr("allowed; press Start again") }
    public pure function input-portal(why: string) -> string { @tr("the remote input portal failed: {}", why) }
    public pure function input-session-lost(why: string) -> string { @tr("the desktop ended remote input: {}", why) }
    public pure function hotkeys-no-keyboard() -> string { @tr("hotkeys are unavailable: no keyboard found") }
    public pure function hotkeys-no-permission() -> string { @tr("hotkeys are unavailable: keyboards cannot be read; add your user to the input group and log in again, or set hotkeys = \"portal\" under [input] for the desktop's shortcuts") }
    public pure function hotkeys-read-failed(why: string) -> string { @tr("hotkeys are unavailable: a keyboard cannot be read: {}", why) }
    public pure function hotkeys-watch-failed(why: string) -> string { @tr("hotkeys stopped: watching for keyboards failed: {}; restart the program", why) }
    public pure function hotkeys-desktop(why: string) -> string { @tr("hotkeys are unavailable: {}", why) }
    public pure function no-recording-desktop() -> string { @tr("recording is unavailable with the desktop's shortcuts") }
    public pure function failure-no-config-directory() -> string { @tr("there is no config directory: neither XDG_CONFIG_HOME nor HOME is set") }
    public pure function failure-write(why: string) -> string { @tr("the config file could not be written: {}", why) }
    public pure function failure-bad-token() -> string { @tr("the activation token is not one") }
    public pure function failure-not-opened() -> string { @tr("the desktop did not open its settings") }
    public pure function desktop-delivers() -> string { @tr("the desktop delivers the hotkeys: change them in System Settings, under Shortcuts") }
    public pure function reads-keyboards() -> string { @tr("the program reads the keyboards: set the hotkeys in this window") }
    public pure function no-shortcuts() -> string { @tr("the desktop's shortcuts are not available") }
    public pure function reason-tray-start-delay(max: string) -> string { @tr("tray_start_delay must be from 0 to {} seconds", max) }
    public pure function reason-interval(floor: string, max: string) -> string { @tr("interval_ms must be from {} to {}", floor, max) }
    public pure function reason-interval-double(floor: string, max: string) -> string { @tr("interval_ms must be from {} to {} for a double click, which fits two clicks in each interval", floor, max) }
    public pure function reason-rate(least: string, most: string) -> string { @tr("clicks_per_second must be from {} to {}", least, most) }
    public pure function reason-rate-double(least: string, most: string) -> string { @tr("clicks_per_second must be from {} to {} for a double click, which fits two clicks in each interval", least, most) }
    public pure function reason-jitter(max: string) -> string { @tr("jitter_percent must be from 0 to {}", max) }
    public pure function reason-speed(slowest: string, fastest: string) -> string { @tr("speed must be from {} to {}", slowest, fastest) }
    public pure function reason-key-code(code: string) -> string { @tr("key code {} is not from 1 to 248", code) }
    public pure function reason-count(count: string, max: string) -> string { @tr("repeat {} is not from 1 to {}; use \"until_stopped\" to repeat until stopped", count, max) }
    public pure function reason-bound-twice(hotkey: string) -> string { @tr("hotkey {} is bound to two actions", hotkey) }
    public pure function reason-on-clicker-key(hotkey: string) -> string { @tr("hotkey {} uses the key the clicker presses; choose another key", hotkey) }
    // The tray's notices, as the window shows them when Play does not start.
    public pure function problem-current-unread(why: string) -> string { @tr("The recording the playback hotkey plays could not be read, so it plays the newest: {}", why) }
    public pure function problem-current-unkept(why: string) -> string { @tr("The recording the playback hotkey plays could not be kept for the next start: {}", why) }
    public pure function refused-clicking(why: string) -> string { @tr("Not started: {}", why) }
    public pure function refused-playback(why: string) -> string { @tr("Not playing: {}", why) }
    public pure function refused-recording(why: string) -> string { @tr("Not recording: {}", why) }
    public pure function unplayable(recording: string, why: string) -> string { @tr("Not playing {}: {}", recording, why) }
    public pure function nothing-to-play() -> string { @tr("Nothing to play: no recordings yet") }
    public pure function run-failed-clicking(why: string) -> string { @tr("Clicking stopped: {}", why) }
    public pure function run-failed-playback(why: string) -> string { @tr("Playback stopped: {}", why) }
    public pure function finished-playing(recording: string) -> string { @tr("Finished playing {}", recording) }
    public pure function finished-all() -> string { @tr("Finished every action") }
    public pure function two-sentences(first: string, second: string) -> string { @tr("{}. {}", first, second) }
    public pure function held-too-long(seconds: string) -> string { @tr("the hotkey was held for {} s; let go of it to start", seconds) }
    public pure function release-lost(hotkey: string) -> string { @tr("could not tell when the hotkey was let go; press {} again", hotkey) }
    public pure function hotkeys-stopped() -> string { @tr("hotkeys stopped working") }
    public pure function clicking-on() -> string { @tr("clicking is on; stop it first") }
    public pure function unlisted(why: string) -> string { @tr("the recordings cannot be listed: {}", why) }
    public pure function no-clock() -> string { @tr("the clock could not be read") }
    public pure function file-missing() -> string { @tr("the file is no longer there") }
    public pure function file-unreadable(why: string) -> string { @tr("the file could not be read: {}", why) }
    public pure function file-too-large(mib: string) -> string { @tr("the file is larger than {} MiB", mib) }
    public pure function file-invalid(why: string) -> string { @tr("invalid recording" => "{}", why) }
    public pure function too-short(ms: string) -> string { @tr("it is shorter than {} ms, too short to play more than once", ms) }
    public pure function presses-hotkey-key(why: string) -> string { @tr("it presses a hotkey's key: {}", why) }
    public pure function stopped(why: string) -> string { @tr("Stopped: {}", why) }
    public pure function layout-changed() -> string { @tr("Playback stopped: the screen layout changed") }
    public pure function layout-unknown() -> string { @tr("Playback stopped: the screen layout is no longer known") }
    public pure function recording-stopped(why: string) -> string { @tr("Recording stopped: {}", why) }
    public pure function recording-full() -> string { @tr("Recording stopped: it reached the largest size a recording may have") }
    public pure function recording-limit(minutes: string) -> string { @tr("Recording stopped at its {}-minute limit", minutes) }
    public pure function played-held(seconds: string) -> string { @tr("Playing although the hotkey was still held after {} s; its keys mix into what plays", seconds) }
    public pure function fallback-unknown() -> string { @tr("Playing with relative motion: the screen layout is not known, so the recorded positions cannot be used") }
    public pure function fallback-changed() -> string { @tr("Playing with relative motion: a screen this recording used has moved, changed size or is gone") }
    public pure function saved-nothing() -> string { @tr("Nothing was recorded, so nothing was saved") }
    public pure function saved-as(name: string) -> string { @tr("Saved “{}”", name) }
    public pure function save-failed(why: string) -> string { @tr("The recording could not be saved: {}", why) }
    public pure function no-data-directory() -> string { @tr("no data directory: neither XDG_DATA_HOME nor HOME is set") }
    public pure function recorded-invalid(why: string) -> string { @tr("recorded invalid" => "{}", why) }
    public pure function own-key-modifier(key: string) -> string { @tr("{} is a modifier, and the program holding it would change which hotkey the desktop sees", key) }
    public pure function own-key-hotkey(key: string, trigger: string) -> string { @tr("{} is the key of the hotkey {}, and the desktop cannot tell the program's key presses from yours", key, trigger) }
    public pure function own-key-unreadable(trigger: string) -> string { @tr("the hotkey “{}” is not on a function key (F1 to F24), so the program cannot tell whether its own key presses would set it off; change it in System Settings", trigger) }
    public pure function own-key-not-reported() -> string { @tr("the desktop has not said yet which keys the hotkeys use, and the program must not press one of them") }
    public pure function unsynced-renamed(why: string) -> string { @tr("Renamed, but it may not survive a power loss: {}", why) }
    public pure function unsynced-deleted(why: string) -> string { @tr("Deleted, but it may not survive a power loss: {}", why) }
    public pure function not-renamed(why: string) -> string { @tr("Not renamed: {}", why) }
    public pure function not-deleted(why: string) -> string { @tr("Not deleted: {}", why) }
    public pure function not-playing() -> string { @tr("Not playing") }
    public pure function file-not-written(why: string) -> string { @tr("the file could not be written: {}", why) }
    public pure function file-not-deleted(why: string) -> string { @tr("the file could not be deleted: {}", why) }
    public pure function rename-too-large(mib: string) -> string { @tr("the file could not be written: the renamed recording would be larger than {} MiB", mib) }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        min-width: 200px;
        vertical-alignment: center;
    }
    @children
}

export component SettingsWindow inherits Window {
    title: @tr("Auto clicker settings");
    preferred-width: 640px;
    preferred-height: 560px;

    // General
    in-out property <int> tray-delay;
    // Clicker
    in-out property <int> mode;
    in-out property <string> interval-text;
    in-out property <int> interval-unit;
    in-out property <int> jitter;
    in-out property <int> button;
    in-out property <string> key-text;
    in-out property <bool> position-fixed;
    in-out property <int> position-x;
    in-out property <int> position-y;
    in-out property <bool> repeat-forever;
    in-out property <string> repeat-text: "1";
    // Hotkeys
    in property <string> hotkey-clicking;
    in property <string> hotkey-recording;
    in property <string> hotkey-playback;
    in property <bool> desktop-hotkeys;
    // Input
    in-out property <int> output-route;
    in-out property <int> hotkeys-route;
    in property <bool> routes-pending;
    // Playback
    in-out property <string> speed-text;
    in-out property <bool> plays-forever;
    in-out property <string> plays-text: "1";
    // Recordings
    in property <[StandardListViewItem]> recordings;
    in property <string> more-recordings;
    in-out property <int> selected: -1;
    in-out property <string> recording-name;
    // State
    in property <bool> idle;
    // The window may send a request: nothing waits on an answer, and no
    // question is open.
    in property <bool> may-ask;
    in property <bool> waiting;
    in property <string> message;
    in property <bool> message-is-error;
    in property <string> confirm-text;
    in property <string> no-recording;
    in property <string> problems;

    callback save();
    callback capture-hotkey(int);
    callback capture-key();
    callback configure-shortcuts();
    callback confirm();
    callback dismiss();
    callback select-recording(int);
    callback rename-recording();
    callback delete-recording();
    callback choose-recording();
    callback play-recording();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        TabWidget {
            Tab {
                title: @tr("Clicker");
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: start;
                        Row {
                            label: @tr("Action");
                            ComboBox {
                                enabled: !root.waiting;
                                model: [@tr("Click"), @tr("Double click"), @tr("Hold the button"), @tr("Repeat a key"), @tr("Hold a key")];
                                current-index <=> root.mode;
                            }
                        }
                        Row {
                            label: @tr("Interval");
                            LineEdit {
                                enabled: !root.waiting;
                                text <=> root.interval-text;
                            }
                            ComboBox {
                                enabled: !root.waiting;
                                model: [@tr("ms between actions"), @tr("actions a second")];
                                current-index <=> root.interval-unit;
                            }
                        }
                        Row {
                            label: @tr("Jitter, percent");
                            SpinBox {
                                enabled: !root.waiting;
                                minimum: 0;
                                maximum: 50;
                                value <=> root.jitter;
                            }
                        }
                        Row {
                            label: @tr("Button");
                            ComboBox {
                                enabled: !root.waiting;
                                model: [@tr("Left"), @tr("Right"), @tr("Middle"), @tr("Back"), @tr("Forward")];
                                current-index <=> root.button;
                            }
                        }
                        Row {
                            label: @tr("Key: a name such as space, or a code such as #113");
                            LineEdit {
                                enabled: !root.waiting;
                                text <=> root.key-text;
                            }
                            if !root.desktop-hotkeys: Button {
                                text: @tr("Change…");
                                enabled: root.idle && root.may-ask;
                                clicked => { root.capture-key(); }
                            }
                        }
                        Row {
                            label: @tr("Where");
                            ComboBox {
                                enabled: !root.waiting;
                                model: [@tr("At the pointer"), @tr("At a fixed point")];
                                current-index: root.position-fixed ? 1 : 0;
                                selected => { root.position-fixed = self.current-index == 1; }
                            }
                        }
                        if root.position-fixed: Row {
                            label: @tr("Point, 0 to 65535 across all screens");
                            Text {
                                text: @tr("X");
                                vertical-alignment: center;
                            }
                            SpinBox {
                                enabled: !root.waiting;
                                minimum: 0;
                                maximum: 65535;
                                value <=> root.position-x;
                            }
                            Text {
                                text: @tr("Y");
                                vertical-alignment: center;
                            }
                            SpinBox {
                                enabled: !root.waiting;
                                minimum: 0;
                                maximum: 65535;
                                value <=> root.position-y;
                            }
                        }
                        Row {
                            label: @tr("Repeat");
                            CheckBox {
                                enabled: !root.waiting;
                                text: @tr("Until stopped");
                                checked <=> root.repeat-forever;
                            }
                            LineEdit {
                                enabled: !root.repeat-forever && !root.waiting;
                                input-type: number;
                                text <=> root.repeat-text;
                            }
                        }
                        Row {
                            label: @tr("Delay before a start from the tray, seconds");
                            SpinBox {
                                enabled: !root.waiting;
                                minimum: 0;
                                maximum: 3600;
                                value <=> root.tray-delay;
                            }
                        }
                    }
                }
            }
            Tab {
                title: @tr("Hotkeys");
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: start;
                    for hotkey[index] in [
                        { label: @tr("Start or stop clicking"), keys: root.hotkey-clicking },
                        { label: @tr("Start or stop recording"), keys: root.hotkey-recording },
                        { label: @tr("Play or stop the recording"), keys: root.hotkey-playback },
                    ]: Row {
                        label: hotkey.label;
                        Text {
                            text: hotkey.keys;
                            vertical-alignment: center;
                            min-width: 160px;
                        }
                        if !root.desktop-hotkeys: Button {
                            text: @tr("Change…");
                            enabled: root.idle && root.may-ask;
                            clicked => { root.capture-hotkey(index); }
                        }
                    }
                    if root.desktop-hotkeys: Text {
                        text: @tr("Plasma delivers the hotkeys, so they are set in System Settings, under Shortcuts.");
                        wrap: word-wrap;
                    }
                    if root.desktop-hotkeys: Button {
                        text: @tr("Change in System Settings");
                        enabled: root.may-ask;
                        clicked => { root.configure-shortcuts(); }
                    }
                    Row {
                        label: @tr("Hotkeys come from");
                        ComboBox {
                            enabled: !root.waiting;
                            model: [@tr("Picked at start"), @tr("The keyboards (needs the input group)"), @tr("Plasma's shortcuts")];
                            current-index <=> root.hotkeys-route;
                        }
                    }
                    Row {
                        label: @tr("Clicks and keys go through");
                        ComboBox {
                            enabled: !root.waiting;
                            model: [@tr("Picked at start"), @tr("/dev/uinput"), @tr("Plasma's remote input")];
                            current-index <=> root.output-route;
                        }
                    }
                    if root.routes-pending: Text {
                        text: @tr("A change of route applies after the program restarts.");
                        wrap: word-wrap;
                    }
                }
            }
            Tab {
                title: @tr("Playback");
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: start;
                    Row {
                        label: @tr("Speed, 0.25 to 4 times as recorded");
                        LineEdit {
                            enabled: !root.waiting;
                            text <=> root.speed-text;
                        }
                    }
                    Row {
                        label: @tr("Plays");
                        CheckBox {
                            enabled: !root.waiting;
                            text: @tr("Until stopped");
                            checked <=> root.plays-forever;
                        }
                        LineEdit {
                            enabled: !root.plays-forever && !root.waiting;
                            input-type: number;
                            text <=> root.plays-text;
                        }
                    }
                    if root.no-recording != "": Text {
                        text: root.no-recording;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Speed and plays apply from the next playback once saved. Changes to the recordings below apply at once.");
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Recordings, newest first; ✓ marks the one the playback hotkey plays");
                        font-weight: 600;
                    }
                    if root.recordings.length == 0: Text {
                        text: @tr("No recordings yet.");
                    }
                    // Arrow keys move the selection, as a click does.
                    StandardListView {
                        min-height: 180px;
                        vertical-stretch: 1;
                        model: root.recordings;
                        current-item <=> root.selected;
                        current-item-changed(index) => { root.select-recording(index); }
                    }
                    if root.more-recordings != "": Text {
                        text: root.more-recordings;
                        wrap: word-wrap;
                    }
                    Row {
                        label: @tr("Name");
                        LineEdit {
                            enabled: root.selected >= 0 && !root.waiting;
                            text <=> root.recording-name;
                        }
                        Button {
                            text: @tr("Rename");
                            enabled: root.selected >= 0 && root.idle && root.may-ask;
                            clicked => { root.rename-recording(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: @tr("Play");
                            enabled: root.selected >= 0 && root.idle && root.may-ask;
                            clicked => { root.play-recording(); }
                        }
                        Button {
                            text: @tr("Play with the hotkey");
                            enabled: root.selected >= 0 && root.idle && root.may-ask;
                            clicked => { root.choose-recording(); }
                        }
                        Button {
                            text: @tr("Delete…");
                            enabled: root.selected >= 0 && root.idle && root.may-ask;
                            clicked => { root.delete-recording(); }
                        }
                    }
                }
            }
            Tab {
                title: @tr("About");
                VerticalLayout {
                    padding: 8px;
                    alignment: start;
                    Text {
                        text: @tr("Auto clicker for KDE Plasma on Wayland.");
                    }
                    AboutSlint { }
                }
            }
        }

        if root.problems != "": Text {
            text: root.problems;
            wrap: word-wrap;
            color: Palette.foreground;
        }
        if root.confirm-text != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.confirm-text;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Yes");
                primary: true;
                enabled: !root.waiting;
                clicked => { root.confirm(); }
            }
            Button {
                text: @tr("No");
                clicked => { root.dismiss(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.message;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: root.message-is-error ? #c42b1c : Palette.foreground;
            }
            Button {
                text: @tr("Save");
                primary: true;
                enabled: root.idle && root.may-ask;
                clicked => { root.save(); }
            }
        }
    }
}
